{
  "name": "appolinaria-portfolio",
  "version": "4.1.0",
  "private": true,
  "description": "Interactive portfolio for Apollinaria Vorobyeva.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{js,ts,json,md,html,css,yml,yaml,xml,txt}\" --ignore-path .prettierignore",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && node tests/runtime-check.mjs",
    "check:all": "npm run check && npm run test:e2e && npm run lighthouse",
    "typecheck": "tsc --noEmit",
    "build:js": "tsc -p tsconfig.build.json",
    "check:runtime": "npm run build:js && node tests/runtime-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.46.0"
  }
}
